{
  "componentName": "Page",
  "state": {
    "formData": {
      "name": "",
      "email": "",
      "phone": "",
      "gender": "",
      "department": "",
      "birthdate": ""
    }
  },
  "children": [
    {
      "componentName": "TinyCard",
      "children": [
        {
          "componentName": "h3",
          "props": {},
          "children": "用户信息登记表"
        },
        {
          "componentName": "TinyForm",
          "props": {
            "model": {
              "type": "JSExpression",
              "value": "this.state.formData"
            },
            "label-position": "top"
          },
          "children": [
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "姓名",
                "prop": "name",
                "required": true
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入您的姓名",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.name"
                    }
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "邮箱",
                "prop": "email",
                "required": true
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入您的邮箱地址",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.email"
                    }
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "手机号码",
                "prop": "phone",
                "required": true
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入您的手机号码",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.phone"
                    }
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "性别",
                "prop": "gender"
              },
              "children": [
                {
                  "componentName": "TinySelect",
                  "props": {
                    "placeholder": "请选择性别",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.gender"
                    },
                    "options": [
                      {
                        "value": "male",
                        "label": "男"
                      },
                      {
                        "value": "female",
                        "label": "女"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "部门",
                "prop": "department"
              },
              "children": [
                {
                  "componentName": "TinySelect",
                  "props": {
                    "placeholder": "请选择部门",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.department"
                    },
                    "options": [
                      {
                        "value": "hr",
                        "label": "人事部"
                      },
                      {
                        "value": "tech",
                        "label": "技术部"
                      },
                      {
                        "value": "sales",
                        "label": "销售部"
                      },
                      {
                        "value": "finance",
                        "label": "财务部"
                      },
                      {
                        "value": "marketing",
                        "label": "市场部"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "出生日期",
                "prop": "birthdate"
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入出生日期，格式：YYYY-MM-DD",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.birthdate"
                    }
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": ""
              },
              "children": [
                {
                  "componentName": "TinyButton",
                  "props": {
                    "text": "提交",
                    "type": "primary",
                    "style": "margin-right: 10px"
                  }
                },
                {
                  "componentName": "TinyButton",
                  "props": {
                    "text": "重置"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}