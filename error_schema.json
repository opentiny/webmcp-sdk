{
  "componentName": "Page",
  "state": {
    "formData": {
      "name": "",
      "gender": "",
      "age": "",
      "email": "",
      "phone": "",
      "department": "",
      "position": "",
      "hobby": []
    }
  },
  "methods": {
    "handleSubmit": {
      "type": "JSFunction",
      "value": "function handleSubmit() { console.log('表单提交数据：', this.state.formData); alert('表单提交成功！'); }"
    },
    "handleReset": {
      "type": "JSFunction",
      "value": "function handleReset() { this.state.formData = { name: '', gender: '', age: '', email: '', phone: '', department: '', position: '', hobby: [] }; }"
    }
  },
  "children": [
    {
      "componentName": "TinyCard",
      "props": {
        "title": "员工信息登记表"
      },
      "children": [
        {
          "componentName": "TinyForm",
          "props": {
            "model": {
              "type": "JSExpression",
              "value": "this.state.formData"
            },
            "labelPosition": "top",
            "labelWidth": "100px"
          },
          "children": [
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "姓名",
                "prop": "name",
                "required": true
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入您的姓名",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.name"
                    }
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "性别",
                "prop": "gender",
                "required": true
              },
              "children": [
                {
                  "componentName": "TinyRadioGroup",
                  "props": {
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.gender"
                    },
                    "options": [
                      {
                        "text": "男",
                        "label": "男"
                      },
                      {
                        "text": "女",
                        "label": "女"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "年龄",
                "prop": "age"
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入年龄",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.age"
                    },
                    "type": "number"
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "邮箱",
                "prop": "email",
                "required": true
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入邮箱地址",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.email"
                    },
                    "type": "email"
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "手机号",
                "prop": "phone",
                "required": true
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入手机号码",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.phone"
                    },
                    "maxlength": "11"
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "部门",
                "prop": "department"
              },
              "children": [
                {
                  "componentName": "TinySelect",
                  "props": {
                    "placeholder": "请选择部门",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.department"
                    },
                    "options": [
                      {
                        "value": "技术部",
                        "label": "技术部"
                      },
                      {
                        "value": "市场部",
                        "label": "市场部"
                      },
                      {
                        "value": "人事部",
                        "label": "人事部"
                      },
                      {
                        "value": "财务部",
                        "label": "财务部"
                      },
                      {
                        "value": "行政部",
                        "label": "行政部"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "职位",
                "prop": "position"
              },
              "children": [
                {
                  "componentName": "TinyInput",
                  "props": {
                    "placeholder": "请输入职位",
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.position"
                    }
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": "兴趣爱好",
                "prop": "hobby"
              },
              "children": [
                {
                  "componentName": "TinyCheckboxGroup",
                  "props": {
                    "modelValue": {
                      "type": "JSExpression",
                      "model": true,
                      "value": "this.state.formData.hobby"
                    },
                    "options": [
                      {
                        "text": "阅读",
                        "label": "阅读"
                      },
                      {
                        "text": "运动",
                        "label": "运动"
                      },
                      {
                        "text": "音乐",
                        "label": "音乐"
                      },
                      {
                        "text": "旅游",
                        "label": "旅游"
                      },
                      {
                        "text": "美食",
                        "label": "美食"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "componentName": "TinyFormItem",
              "props": {
                "label": ""
              },
              "children": [
                {
                  "componentName": "TinyButton",
                  "props": {
                    "text": "提交",
                    "type": "primary",
                    "onClick": {
                      "type": "JSExpression",
                      "value": "this.handleSubmit"
                    },
                    "style": "margin-right: 10px;"
                  }
                },
                {
                  "componentName": "TinyButton",
                  "props": {
                    "text": "重置",
                    "onClick": {
                      "type": "JSExpression",
                      "value": "this.handleReset"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}