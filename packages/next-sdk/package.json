{
  "name": "@opentiny/next-sdk",
  "version": "0.4.3",
  "type": "module",
  "homepage": "https://docs.opentiny.design/next-sdk/guide/",
  "repository": {
    "type": "git",
    "url": "git@github.com:opentiny/next-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/opentiny/next-sdk/issues"
  },
  "keywords": [
    "next-sdk",
    "opentiny",
    "mcp",
    "sdk",
    "agent"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Chunhui Mo",
  "main": "index.ts",
  "module": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./core": {
      "import": "./core.ts",
      "types": "./core.ts"
    }
  },
  "description": "A frontend intelligent application development toolkit designed to simplify WebAgent integration and usage, supporting multiple programming languages and frontend frameworks to help developers rapidly implement intelligent features",
  "scripts": {
    "build": "vite build && vite build --config vite.config.runtime.ts",
    "build:runtime": "vite build --config vite.config.runtime.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "catalog:",
    "@ai-sdk/mcp": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@mcp-b/webmcp-polyfill": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@opentiny/next": "catalog:",
    "@page-agent/page-controller": "catalog:",
    "ai": "catalog:",
    "ai-motion": "^0.4.8",
    "ajv": "catalog:",
    "aria-query": "catalog:",
    "diff": "catalog:",
    "dom-accessibility-api": "catalog:",
    "qrcode": "catalog:",
    "tabbable": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/diff": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "module": "dist/index.js",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./core": {
        "import": "./dist/core.js",
        "types": "./dist/core.d.ts"
      }
    }
  }
}
