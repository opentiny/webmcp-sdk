  "description": "A frontend intelligent application development toolkit designed to simplify WebAgent integration and usage, supporting multiple programming languages and frontend frameworks to help developers rapidly implement intelligent features",
  "scripts": {
    "dev": "vite --config vite.config-dev.ts",
    "build": "vite build"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^5.0.0 ",
    "@ai-sdk/deepseek": "^3.0.0",
    "@mcp-b/webmcp-polyfill": "^3.0.0",
    "@mcp-b/webmcp-types": "^3.0.0",
    "@modelcontextprotocol/sdk": "catalog:",
    "@page-agent/page-controller": "catalog:",
    "ai": "^7.0.0",
    "json-schema-to-zod": "catalog:",
    "zod-to-json-schema": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:",
    "dom-accessibility-api": "catalog:",
    "tabbable": "catalog:",
    "diff": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/diff": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vite-plugin-dts": "catalog:"
