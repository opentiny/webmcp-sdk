{
  "name": "@opentiny/webmcp-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome remote debugging CLI tool for WebMCP",
  "main": "dist/index.js",
  "bin": {
    "webmcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --loader tsx src/index.ts",
