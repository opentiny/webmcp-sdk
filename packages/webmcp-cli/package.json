{
  "name": "@opentiny/webmcp-cli",
  "version": "0.0.5",
  "type": "module",
  "description": "WebMCP CLI for AI Agents to interact with browser via Puppeteer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "webmcp-cli": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build:inject": "node scripts/build-inject.mjs",
    "build": "tsup && pnpm run build:inject",
    "prepublishOnly": "pnpm run build",
    "link:global": "npm install -g .",
    "start": "node dist/bin.js"
  },
  "keywords": [
    "chrome",
    "puppeteer",
    "cli"
  ],
  "license": "MIT",
  "author": "OpenTiny Team",
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "catalog:",
    "@opentiny/next-sdk": "workspace:^",
    "@page-agent/page-controller": "catalog:",
    "clipboardy": "^5.3.1",
    "commander": "^11.1.0",
    "json5": "^2.2.3",
    "marked": "^15.0.7",
    "picocolors": "^1.0.0",
    "puppeteer-core": "^22.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "tsup": "^8.0.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.3"
  }
}
