{
  "name": "@opentiny/next-wxt",
  "description": "Opentiny Next 框架的浏览器扩展插件",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt prepare && wxt --mode open",
    "dev:inner": "wxt prepare && wxt --mode inner",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build --mode open",
    "build:inner": "wxt build --mode inner",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "catalog:",
    "vant": "catalog:",
    "@opentiny/vue": "catalog:",
    "@opentiny/vue-icon": "catalog:",
    "puppeteer-core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "wxt": "catalog:",
    "webext-bridge": "catalog:",
    "@opentiny/next-remoter": "workspace:*",
    "@opentiny/next-sdk": "workspace:*",
    "@opentiny/unplugin-tiny-vue": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "@vant/auto-import-resolver": "catalog:",
    "vite-svg-loader": "catalog:",
    "@wxt-dev/auto-icons": "catalog:",
    "@wxt-dev/storage": "catalog:",
    "chokidar": "catalog:",
    "glob": "catalog:"
  }
}
