{
  "name": "@opentiny/next-wxt",
  "description": "Opentiny Next 框架的浏览器扩展插件",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt prepare && wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.21",
    "vant": "^4.9.21"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.2",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.6",
    "wxt": "^0.20.6",
    "webext-bridge": "6.0.1",
    "@opentiny/next-remoter": "workspace:*",
    "@opentiny/next-sdk": "workspace:*",
    "@opentiny/unplugin-tiny-vue": "^1.0.0",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.26.0",
    "@vant/auto-import-resolver": "^1.3.0",
    "vite-svg-loader": "^5.1.0"
  }
}
